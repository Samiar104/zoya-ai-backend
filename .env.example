# ZOYA AI Backend — environment template.
# Copy to .env and fill in real values. NEVER commit a real .env.
# The API key and JWT secret are generated once at first start if missing
# (see app/core/security.py) and written to .env automatically.

# --- Core ---
APP_NAME=ZOYA AI Backend
APP_VERSION=1.0.0
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Database ---
# SQLite by default (portable file). For PostgreSQL set e.g.:
# DATABASE_URL=postgresql+psycopg2://zoya:password@localhost:5432/zoya
DATABASE_URL=sqlite:///./zoya.db

# --- Security ---
# Long random secret used to sign JWTs. Change it in production.
SECRET_KEY=change-me-to-a-long-random-secret
# Static API key for devices/services. NEVER EXPIRES by design (user requirement).
# Leave empty on first run: a secure key is generated and saved to .env.
ZOYA_API_KEY=

# JWT tokens issued by this backend carry NO expiry (exp) claim, per the
# project requirement that keys/tokens never expire. Revocation works by
# deactivating the user or rotating SECRET_KEY. See README "Security".

# --- CORS ---
# Comma-separated origins allowed to call the API (website, dashboard).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120

# --- Voice engine ---
# "stub" (default) = honest placeholder that returns 501 with setup help.
# "whisper" = use faster-whisper for STT if installed (see README).
# "piper"   = use Piper for TTS if installed (see README).
VOICE_ENGINE=stub
VOICE_DEFAULT_LANGUAGE=hi
# ZOYA personality / languages
ZOYA_LANGUAGES=hi,ur,pa,en,ur_roman
ZOYA_PERSONALITY=friendly,witty,supportive

# --- ZOYA character profile ---
# Shown by GET /character. avatar_url is the character image file
# (zoya-character.png lives in the project workspace; the website/app
# serve it from there or from a CDN — see README).
ZOYA_NAME=ZOYA
ZOYA_TAGLINE=Your AI friend, assistant and companion.
ZOYA_DESCRIPTION=ZOYA is a warm, witty and supportive AI personal assistant. She speaks Hindi, Urdu, Punjabi and English, remembers what matters to you, notices how you feel, and helps you get things done on your phone — gently, and always with your permission.
ZOYA_BACKSTORY=ZOYA was built as a personal companion who grows with her user. She started as a voice in a phone and became a friend who remembers your favourite songs, your late-night worries and your small wins — and celebrates them with you.
ZOYA_TRAITS=friendly,witty,supportive,curious,patient,playful
ZOYA_VOICE_CHARACTER=Natural human-like female voice, warm and expressive, medium pitch, calm pace
ZOYA_AVATAR_URL=zoya-character.png
ZOYA_MODES=assistant,companion

# --- Backups ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
